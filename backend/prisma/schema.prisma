generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Standort {
  id     String @id @default(uuid())
  name   String @unique
  nutzer Nutzer[]
  wareneintraege Wareneintrag[]

  @@map("standorte")
}

model Nutzer {
  id     String @id @default(uuid())
  vorname   String
  nachname  String
  email     String @unique
  standortId String @map("standort_id")
  standort   Standort @relation(fields: [standortId], references: [id])

  passwortHash String @map("passwort_hash")

  // Sieht den Admin-Bereich (Nutzerliste, Nutzer anlegen, Passwort-Mails).
  // Initial der Bootstrap-Nutzer, siehe ADR-0006.
  istAdmin Boolean @default(false) @map("ist_admin")

  // Zeitpunkt der letzten Passwortänderung. JwtStrategy lehnt Tokens ab,
  // die vor diesem Zeitpunkt ausgestellt wurden (Invalidierung nach
  // Passwortänderung/-Reset, siehe Issue #40).
  passwortGeaendertAm DateTime @default(now()) @map("passwort_geaendert_am")

  // true bis der Nutzer sein eigenes Passwort gesetzt hat (Initial-Zugang)
  mussPasswortSetzen Boolean @default(true) @map("muss_passwort_setzen")

  // gemeinsamer Mechanismus für Initial-Zugang und "Passwort vergessen"
  passwortSetzenToken       String?   @unique @map("passwort_setzen_token")
  passwortSetzenTokenAblauf DateTime? @map("passwort_setzen_token_ablauf")

  erstelltVonId String? @map("erstellt_von_id")
  erstelltVon   Nutzer? @relation("NutzerErstelltVon", fields: [erstelltVonId], references: [id])
  erstellteNutzer Nutzer[] @relation("NutzerErstelltVon")

  wareneintraege Wareneintrag[]
  analysen       WareneintragAnalyse[]

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  @@map("nutzer")
}

model AvvCode {
  id             String         @id @default(uuid())
  code           String         @unique
  bezeichnung    String
  gefaehrlich    Boolean
  wareneintraege Wareneintrag[]

  @@map("avv_codes")
}

model Wareneintrag {
  id     String @id @default(uuid())

  // Alle drei optional: der Nutzer entscheidet selbst, wie viele Ansichten
  // er fotografiert (0 bis 3), siehe CONTEXT.md.
  fotoFernUrl   String? @map("foto_fern_url")
  fotoNahUrl    String? @map("foto_nah_url")
  fotoDetailUrl String? @map("foto_detail_url")

  // Optionales PDF, z. B. Lieferschein (Issue #103). Wie die Fotos nur ein
  // Object-Storage-Key, fließt nicht in die KI-Analyse ein.
  dokumentUrl String? @map("dokument_url")

  avvCodeId String  @map("avv_code_id")
  avvCode   AvvCode @relation(fields: [avvCodeId], references: [id])

  freitext String

  // Standort als Kopie des Nutzer-Standorts zum Erfassungszeitpunkt, siehe
  // ADR-0004 – deshalb zusätzlich zu erfasstVonId, nicht nur darüber ableitbar.
  erfasstVonId String @map("erfasst_von_id")
  erfasstVon   Nutzer @relation(fields: [erfasstVonId], references: [id])

  standortId String   @map("standort_id")
  standort   Standort @relation(fields: [standortId], references: [id])

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  analyse WareneintragAnalyse?

  @@map("wareneintraege")
}

// Gespeicherte KI-Analyse, genau eine pro Wareneintrag (ADR-0008). Speichern
// überschreibt, Löschen des Eintrags löscht sie mit.
model WareneintragAnalyse {
  wareneintragId String       @id @map("wareneintrag_id")
  wareneintrag   Wareneintrag @relation(fields: [wareneintragId], references: [id], onDelete: Cascade)

  // { fraktionen: [{ name, anteilProzent }], einschaetzung }, geprüft und
  // gerundet aus der Redis-Vorschau, nie aus dem Client.
  ergebnis Json

  analysiertVonId String @map("analysiert_von_id")
  analysiertVon   Nutzer @relation(fields: [analysiertVonId], references: [id])

  analysiertAm DateTime @default(now()) @map("analysiert_am")

  @@map("wareneintrag_analysen")
}

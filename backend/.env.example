DATABASE_URL=postgres://research:research@localhost:5432/research
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Optional: nur nötig, wenn OBJECT_STORAGE_ENDPOINT ein Docker-interner
# Hostname ist (z.B. "http://minio:9000" in docker-compose.yml), der Browser
# aber eine andere, von außen erreichbare Adresse für Foto-URLs braucht.
# OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=research
OBJECT_STORAGE_SECRET_ACCESS_KEY=research-secret
OBJECT_STORAGE_BUCKET=research-fotos
PORT=3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Wird beim Signieren gesetzt und beim Verifizieren geprüft (Issue #34).
JWT_ISSUER=research-backend
JWT_AUDIENCE=research-frontend

# Geteilter Rate-Limit-Zähler (@nestjs/throttler), siehe docker-compose.yml
REDIS_URL=redis://localhost:6379

# Nur für prisma/seed-initial-nutzer.ts (einmaliger Bootstrap)
INITIAL_NUTZER_EMAIL=nutzer@example.com
INITIAL_NUTZER_PASSWORT=change-me
INITIAL_NUTZER_STANDORT=Hauptsitz

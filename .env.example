# Für docker compose: Kopie als ".env" im Repo-Root anlegen und Werte
# anpassen. docker-compose.yml lädt ".env" automatisch, wenn vorhanden; ohne
# die Datei greifen die unsicheren Platzhalter-Defaults aus
# docker-compose.yml (nur für lokale Entwicklung geeignet).

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

INITIAL_VORGESETZTER_EMAIL=vorgesetzter@example.com
INITIAL_VORGESETZTER_PASSWORT=change-me-now

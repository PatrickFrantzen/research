# Für docker compose: Kopie als ".env" im Repo-Root anlegen und Werte
# anpassen. docker-compose.yml lädt ".env" automatisch, wenn vorhanden; ohne
# die Datei greifen die unsicheren Platzhalter-Defaults aus
# docker-compose.yml (nur für lokale Entwicklung geeignet).

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

INITIAL_NUTZER_EMAIL=nutzer@example.com
INITIAL_NUTZER_PASSWORT=change-me-now

# Mailversand (Einladungen, Passwort-Links). Ohne SMTP_HOST werden Mails nur
# geloggt. web.de: smtp.web.de, Port 587, User = volle Adresse.
# SMTP_HOST=smtp.web.de
# SMTP_PORT=587
# SMTP_USER=absender@web.de
# SMTP_PASSWORT=
# APP_URL=http://localhost:3000

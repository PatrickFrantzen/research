# Kopie als ".env" neben docker-compose.prod.yml auf dem Server anlegen.
# Alle Werte mit echten, langen Zufallsstrings/Domains ersetzen – siehe
# docs/research/03-docker-deployment-optionen.md Go-live-Checkliste.

# DNS-A-Records müssen VOR dem ersten Start auf die Server-IP zeigen,
# sonst schlägt die automatische Let's-Encrypt-Ausstellung fehl.
DOMAIN=demo.printbypatrick.de
FILES_DOMAIN=fotos-demo.printbypatrick.de

JWT_SECRET=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
MINIO_APP_SECRET=

INITIAL_NUTZER_EMAIL=
INITIAL_NUTZER_PASSWORT=
